{
  "version": 2,
  "name": "sync-engine-frontend",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sync-engine-server.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://sync-engine-server.onrender.com/uploads/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://sync-engine-server.onrender.com/socket.io/:path*"
    }
  ]
}
